        "answer": "Stay calm, restate policy, warm-transfer to a supervisor if threats continue",
        "passingScore": 1
      }
    ],
    "theme": { "preset": "brand" },
    "tracking": { "completion": { "threshold": 1 } }
  },
  "paths": {
    "spaDistDir": "dist",
    "lxpackOutDir": ".lxpack/course",
    "outputBaseDir": ".lxpack/out"
  }
}
