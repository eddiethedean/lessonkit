{
  "name": "@lessonkit/studio-renderer",
  "version": "0.3.2",
  "private": false,
  "description": "React renderer for LessonKit Studio project documents.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eddiethedean/lessonkit.git",
    "directory": "packages/studio-renderer"
  },
  "homepage": "https://lessonkit.readthedocs.io/en/latest/guides/studio/index.html",
  "bugs": {
    "url": "https://github.com/eddiethedean/lessonkit/issues"
  },
  "keywords": [
    "lessonkit",
    "lessonkit-studio",
    "react",
    "renderer",
    "authoring"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --external react --external react-dom --external @lessonkit/react --external @lessonkit/themes --external @lessonkit/core --external @lessonkit/studio-schema",
    "dev": "tsup src/index.tsx --format esm,cjs --dts --watch --external react --external react-dom --external @lessonkit/react --external @lessonkit/themes --external @lessonkit/core --external @lessonkit/studio-schema",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "echo \"(no lint configured yet)\""
  },
  "dependencies": {
    "@lessonkit/studio-schema": "file:../studio-schema",
    "@lessonkit/core": "file:../core",
    "@lessonkit/react": "file:../react",
    "@lessonkit/themes": "file:../themes"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/node": "^22.13.10",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
