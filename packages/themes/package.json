{
  "name": "@lessonkit/themes",
  "version": "0.7.0",
  "private": false,
  "description": "Theme primitives and tokens for LessonKit.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eddiethedean/lessonkit.git",
    "directory": "packages/themes"
  },
  "homepage": "https://github.com/eddiethedean/lessonkit",
  "bugs": {
    "url": "https://github.com/eddiethedean/lessonkit/issues"
  },
  "keywords": [
    "lessonkit",
    "theme",
    "design-tokens"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./theme-contract.v1.json": "./theme-contract.v1.json",
    "./theme-catalog.v1.json": "./theme-catalog.v1.json",
    "./base.css": "./base.css"
  },
  "files": [
    "dist",
    "theme-contract.v1.json",
    "theme-catalog.v1.json",
    "base.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --passWithNoTests=false",
    "lint": "echo \"(no lint configured yet)\""
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
