{
  "name": "@lessonkit/studio-schema",
  "version": "0.3.0",
  "private": false,
  "description": "LessonKit Studio project schema, validation, and normalization (v1).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eddiethedean/lessonkit.git",
    "directory": "packages/studio-schema"
  },
  "homepage": "https://github.com/eddiethedean/lessonkit/tree/main/packages/studio-schema",
  "bugs": {
    "url": "https://github.com/eddiethedean/lessonkit/issues"
  },
  "keywords": [
    "lessonkit",
    "lessonkit-studio",
    "schema",
    "authoring",
    "learning"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./studio-project.v1.json": "./studio-project.v1.json",
    "./studio-block-catalog.v1.json": "./studio-block-catalog.v1.json"
  },
  "files": [
    "dist",
    "studio-project.v1.json",
    "studio-block-catalog.v1.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "echo \"(no lint configured yet)\""
  },
  "dependencies": {
    "@lessonkit/core": "file:../core"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
