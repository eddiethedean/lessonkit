{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lessonkit.dev/schemas/studio-project.v1.json",
  "title": "LessonKit Studio Project",
  "type": "object",
  "required": ["schemaVersion", "course", "pages"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "course": {
      "type": "object",
      "required": ["courseId", "title"],
      "additionalProperties": false,
      "properties": {
        "courseId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "required": ["id", "title", "blocks"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/textBlock" },
        { "$ref": "#/$defs/headingBlock" },
        { "$ref": "#/$defs/imageBlock" },
        { "$ref": "#/$defs/buttonBlock" },
        { "$ref": "#/$defs/inputBlock" },
        { "$ref": "#/$defs/containerBlock" },
        { "$ref": "#/$defs/quizBlock" },
        { "$ref": "#/$defs/scenarioBlock" },
        { "$ref": "#/$defs/checklistBlock" },
        { "$ref": "#/$defs/videoBlock" }
      ]
    },
    "textBlock": {
      "type": "object",
      "required": ["type", "id", "text"],
      "properties": {
        "type": { "const": "text" },
        "id": { "type": "string" },
        "text": { "type": "string" }
      }
    },
    "headingBlock": {
      "type": "object",
      "required": ["type", "id", "level", "text"],
      "properties": {
        "type": { "const": "heading" },
        "id": { "type": "string" },
        "level": { "enum": [1, 2, 3] },
        "text": { "type": "string" }
      }
    },
    "imageBlock": {
      "type": "object",
      "required": ["type", "id", "src", "alt"],
      "properties": {
        "type": { "const": "image" },
        "id": { "type": "string" },
        "src": { "type": "string" },
        "alt": { "type": "string" }
      }
    },
    "buttonBlock": {
      "type": "object",
      "required": ["type", "id", "label"],
      "properties": {
        "type": { "const": "button" },
        "id": { "type": "string" },
        "label": { "type": "string" },
        "href": { "type": "string" }
      }
    },
    "inputBlock": {
      "type": "object",
      "required": ["type", "id", "label"],
      "properties": {
        "type": { "const": "input" },
        "id": { "type": "string" },
        "label": { "type": "string" },
        "inputType": { "enum": ["text", "email", "number"] },
        "placeholder": { "type": "string" }
      }
    },
    "containerBlock": {
      "type": "object",
      "required": ["type", "id", "blocks"],
      "properties": {
        "type": { "const": "container" },
        "id": { "type": "string" },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
      }
    },
    "quizBlock": {
      "type": "object",
      "required": ["type", "id", "checkId", "question", "choices", "answer"],
      "properties": {
        "type": { "const": "quiz" },
        "id": { "type": "string" },
        "checkId": { "type": "string" },
        "question": { "type": "string" },
        "choices": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "answer": { "type": "string" }
      }
    },
    "scenarioBlock": {
      "type": "object",
      "required": ["type", "id", "blocks"],
      "properties": {
        "type": { "const": "scenario" },
        "id": { "type": "string" },
        "blockId": { "type": "string" },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
      }
    },
    "checklistBlock": {
      "type": "object",
      "required": ["type", "id", "items"],
      "properties": {
        "type": { "const": "checklist" },
        "id": { "type": "string" },
        "items": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "videoBlock": {
      "type": "object",
      "required": ["type", "id", "src"],
      "properties": {
        "type": { "const": "video" },
        "id": { "type": "string" },
        "src": { "type": "string" },
        "title": { "type": "string" }
      }
    }
  }
}
