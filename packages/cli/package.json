{
  "name": "@lessonkit/cli",
  "version": "1.0.0",
  "private": false,
  "description": "LessonKit CLI — init, dev, build, and package learning experiences.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eddiethedean/lessonkit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/eddiethedean/lessonkit",
  "bugs": {
    "url": "https://github.com/eddiethedean/lessonkit/issues"
  },
  "keywords": [
    "lessonkit",
    "cli",
    "learning",
    "scorm",
    "xapi"
  ],
  "type": "module",
  "bin": {
    "lessonkit": "./dist/bin.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "template"
  ],
  "scripts": {
    "copy-template": "node scripts/copy-template.mjs",
    "build": "npm run copy-template && tsup src/index.ts src/bin.ts --format esm --splitting=false --platform node --target node18 --dts",
    "dev": "npm run copy-template && tsup src/index.ts src/bin.ts --format esm --watch --splitting=false --platform node --target node18 --dts",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests=false",
    "lint": "echo \"(no lint configured yet)\""
  },
  "dependencies": {
    "@lessonkit/core": "1.0.0",
    "@lessonkit/lxpack": "1.0.0",
    "commander": "^14.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
