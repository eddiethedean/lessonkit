{
  "name": "{{name}}",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "lessonkit dev",
    "build": "lessonkit build",
    "preview": "vite preview",
    "package:scorm12": "lessonkit package --target scorm12",
    "package:standalone": "lessonkit package --target standalone",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests=false"
  },
  "dependencies": {
    "@lessonkit/core": "^0.9.3",
    "@lessonkit/react": "^0.9.3",
    "@lessonkit/themes": "^0.9.3",
    "@lessonkit/xapi": "^0.9.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@lessonkit/cli": "^0.9.3",
    "@lessonkit/lxpack": "^0.9.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
