{
  "name": "@lessonkit/react",
  "version": "1.7.1",
  "private": false,
  "description": "React components and hooks for building learning experiences with LessonKit.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eddiethedean/lessonkit.git",
    "directory": "packages/react"
  },
  "homepage": "https://lessonkit.readthedocs.io/en/latest/guides/react-developers/components-and-hooks.html",
  "bugs": {
    "url": "https://github.com/eddiethedean/lessonkit/issues"
  },
  "keywords": [
    "lessonkit",
    "react",
    "learning",
    "training",
    "lms",
    "scorm",
    "xapi"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./blocks": {
      "types": "./dist/blocks-entry.d.ts",
      "import": "./dist/blocks-entry.js",
      "require": "./dist/blocks-entry.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./block-catalog.v1.json": "./block-catalog.v1.json",
    "./block-catalog.v2.json": "./block-catalog.v2.json",
    "./block-catalog.v3.json": "./block-catalog.v3.json",
    "./block-contract.v1.json": "./block-contract.v1.json",
    "./block-contract.v2.json": "./block-contract.v2.json",
    "./block-contract.v3.json": "./block-contract.v3.json"
  },
  "files": [
    "dist",
    "block-catalog.v1.json",
    "block-catalog.v2.json",
    "block-catalog.v3.json",
    "block-contract.v1.json",
    "block-contract.v2.json",
    "block-contract.v3.json"
  ],
  "scripts": {
    "build": "tsup src/index.tsx src/testing.ts src/blocks-entry.ts --format esm,cjs --dts --tsconfig tsconfig.build.json --external react --external react-dom --external @lessonkit/accessibility --external @lessonkit/lxpack --external @lessonkit/themes",
    "dev": "tsup src/index.tsx src/testing.ts src/blocks-entry.ts --format esm,cjs --dts --watch --tsconfig tsconfig.build.json --external react --external react-dom --external @lessonkit/accessibility --external @lessonkit/lxpack --external @lessonkit/themes",
    "storybook": "storybook dev -c .storybook -p 6006 --disable-telemetry",
    "build-storybook": "storybook build -c .storybook --disable-telemetry",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests=false",
    "lint": "eslint --max-warnings 0 \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" \"stories/**/*.{ts,tsx}\""
  },
  "peerDependencies": {
    "@lessonkit/lxpack": "1.7.1",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@lessonkit/lxpack": {
      "optional": true
    }
  },
  "dependencies": {
    "@lessonkit/accessibility": "1.7.1",
    "@lessonkit/core": "1.7.1",
    "@lessonkit/lxpack": "1.7.1",
    "@lessonkit/themes": "1.7.1",
    "@lessonkit/xapi": "1.7.1"
  },
  "devDependencies": {
    "@storybook/builder-vite": "10.4.2",
    "@storybook/react": "10.4.2",
    "@storybook/react-vite": "10.4.2",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "10.4.2",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.8",
    "@testing-library/dom": "^10.4.1"
  }
}
