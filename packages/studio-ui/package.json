{
  "name": "@lessonkit/studio-ui",
  "version": "0.3.1",
  "private": false,
  "description": "React visual editor UI for LessonKit Studio.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eddiethedean/lessonkit.git",
    "directory": "packages/studio-ui"
  },
  "homepage": "https://github.com/eddiethedean/lessonkit/tree/main/packages/studio-ui",
  "bugs": {
    "url": "https://github.com/eddiethedean/lessonkit/issues"
  },
  "keywords": [
    "lessonkit",
    "lessonkit-studio",
    "react",
    "editor"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --external react --external react-dom --external @lessonkit/react --external @lessonkit/themes --external @lessonkit/core --external @lessonkit/studio-schema --external @lessonkit/studio-renderer --external @lessonkit/studio-builder --external @lessonkit/studio-codegen",
    "dev": "tsup src/index.tsx --format esm,cjs --dts --watch --external react --external react-dom --external @lessonkit/react --external @lessonkit/themes --external @lessonkit/core --external @lessonkit/studio-schema --external @lessonkit/studio-renderer --external @lessonkit/studio-builder --external @lessonkit/studio-codegen",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "echo \"(no lint configured yet)\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-virtual": "^3.13.12",
    "@lessonkit/studio-builder": "file:../studio-builder",
    "@lessonkit/studio-codegen": "file:../studio-codegen",
    "@lessonkit/studio-renderer": "file:../studio-renderer",
    "@lessonkit/studio-schema": "file:../studio-schema",
    "@lessonkit/core": "file:../core",
    "@lessonkit/react": "file:../react",
    "@lessonkit/themes": "file:../themes",
    "zustand": "^5.0.8"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
