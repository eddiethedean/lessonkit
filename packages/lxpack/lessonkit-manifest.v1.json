{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lessonkit.dev/schemas/lessonkit-manifest.v1.json",
  "title": "LessonkitManifestV1",
  "description": "Root lessonkit.json project manifest (schemaVersion 1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "course"],
  "properties": {
    "schemaVersion": {
      "description": "Must be 1. String \"1\" is coerced to number 1 at parse time.",
      "oneOf": [{ "const": 1 }, { "type": "string", "const": "1" }]
    },
    "name": { "type": "string", "minLength": 1 },
    "course": { "$ref": "#/$defs/LessonkitCourseDescriptor" },
    "paths": {
      "type": "object",
      "description": "Optional. Omitted keys default to spaDistDir=dist, lxpackOutDir=.lxpack/course, outputBaseDir=.lxpack/out.",
      "additionalProperties": false,
      "properties": {
        "spaDistDir": { "type": "string", "minLength": 1 },
        "lxpackOutDir": { "type": "string", "minLength": 1 },
        "outputBaseDir": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "LessonkitId": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "LessonkitCourseDescriptor": {
      "type": "object",
      "required": ["courseId", "title", "layout", "lessons"],
      "properties": {
        "courseId": { "$ref": "#/$defs/LessonkitId" },
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "layout": { "enum": ["single-spa", "per-lesson-spa"] },
        "lessons": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/LessonDescriptor" }
        },
        "assessments": {
          "type": "array",
          "items": { "$ref": "#/$defs/AssessmentDescriptor" }
        },
        "theme": {
          "type": "object",
          "properties": {
            "preset": { "enum": ["default", "light", "dark", "brand"] },
            "theme": { "type": "object" }
          }
        },
        "tracking": {
          "type": "object",
          "properties": {
            "completion": {
              "type": "object",
              "properties": {
                "threshold": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            },
            "xapi": {
              "type": "object",
              "properties": {
                "activityIri": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "spaDistDir": { "type": "string", "minLength": 1 },
        "spaLessonId": { "$ref": "#/$defs/LessonkitId" }
      }
    },
    "LessonDescriptor": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/LessonkitId" },
        "title": { "type": "string", "minLength": 1 },
        "spaPath": { "type": "string", "minLength": 1 }
      }
    },
    "AssessmentDescriptor": {
      "oneOf": [
        { "$ref": "#/$defs/McqAssessmentDescriptor" },
        { "$ref": "#/$defs/TrueFalseAssessmentDescriptor" },
        { "$ref": "#/$defs/FillInBlanksAssessmentDescriptor" },
        { "$ref": "#/$defs/FindHotspotAssessmentDescriptor" },
        { "$ref": "#/$defs/FindMultipleHotspotsAssessmentDescriptor" }
      ]
    },
    "AssessmentBase": {
      "type": "object",
      "required": ["checkId", "question"],
      "properties": {
        "checkId": { "$ref": "#/$defs/LessonkitId" },
        "question": { "type": "string", "minLength": 1 },
        "passingScore": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "McqAssessmentDescriptor": {
      "allOf": [
        { "$ref": "#/$defs/AssessmentBase" },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "mcq" },
            "choices": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "answer": { "type": "string", "minLength": 1 }
          },
          "required": ["choices", "answer"]
        }
      ]
    },
    "TrueFalseAssessmentDescriptor": {
      "allOf": [
        { "$ref": "#/$defs/AssessmentBase" },
        {
          "type": "object",
          "required": ["kind", "answer"],
          "properties": {
            "kind": { "const": "trueFalse" },
            "answer": { "type": "boolean" }
          }
        }
      ]
    },
    "FillInBlanksAssessmentDescriptor": {
      "allOf": [
        { "$ref": "#/$defs/AssessmentBase" },
        {
          "type": "object",
          "required": ["kind", "template"],
          "properties": {
            "kind": { "const": "fillInBlanks" },
            "template": { "type": "string", "minLength": 1 },
            "blanks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "answer"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "answer": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      ]
    },
    "FindHotspotAssessmentDescriptor": {
      "allOf": [
        { "$ref": "#/$defs/AssessmentBase" },
        {
          "type": "object",
          "required": ["kind", "src", "alt", "correctTargetId"],
          "properties": {
            "kind": { "const": "findHotspot" },
            "src": { "type": "string", "minLength": 1 },
            "alt": { "type": "string", "minLength": 1 },
            "correctTargetId": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "FindMultipleHotspotsAssessmentDescriptor": {
      "allOf": [
        { "$ref": "#/$defs/AssessmentBase" },
        {
          "type": "object",
          "required": ["kind", "src", "alt", "correctTargetIds"],
          "properties": {
            "kind": { "const": "findMultipleHotspots" },
            "src": { "type": "string", "minLength": 1 },
            "alt": { "type": "string", "minLength": 1 },
            "correctTargetIds": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    }
  }
}
