{
  "name": "@lessonkit/lxpack",
  "version": "1.7.1",
  "private": false,
  "description": "LXPack export adapter for LessonKit courses (SCORM, standalone, xAPI, cmi5).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eddiethedean/lessonkit.git",
    "directory": "packages/lxpack"
  },
  "homepage": "https://lessonkit.readthedocs.io/en/latest/reference/packaging.html",
  "bugs": {
    "url": "https://github.com/eddiethedean/lessonkit/issues"
  },
  "keywords": [
    "lessonkit",
    "lxpack",
    "scorm",
    "lms",
    "packaging",
    "elearning"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.js",
      "require": "./dist/bridge.cjs"
    },
    "./lessonkit-manifest.v1.json": "./lessonkit-manifest.v1.json",
    "./lkcourse-format.v1.json": "./lkcourse-format.v1.json",
    "./block-tree.v1.json": "./block-tree.v1.json"
  },
  "files": [
    "dist",
    "lessonkit-manifest.v1.json",
    "lkcourse-format.v1.json",
    "block-tree.v1.json"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/bridge.ts --format esm,cjs --dts --tsconfig tsconfig.build.json",
    "dev": "tsup src/index.ts src/bridge.ts --format esm,cjs --dts --watch --tsconfig tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests=false",
    "lint": "eslint --max-warnings 0 \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@lessonkit/core": "1.7.1",
    "@lessonkit/themes": "1.7.1",
    "@lxpack/api": "0.7.0",
    "@lxpack/spa-bridge": "0.7.0",
    "@lxpack/tracking-schema": "0.7.0",
    "@lxpack/validators": "0.7.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@lessonkit/react": "1.7.1",
    "@types/node": "^25.9.2",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
